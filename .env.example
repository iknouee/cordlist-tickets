# Create a bot in the Discord Developer Portal and keep this token private.
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Optional: set this for quick guild-only command updates while testing.
# Leave blank to deploy commands globally.
DISCORD_GUILD_ID=

# Persistent JSON state and generated HTML transcripts are stored here.
DATA_DIR=./data
